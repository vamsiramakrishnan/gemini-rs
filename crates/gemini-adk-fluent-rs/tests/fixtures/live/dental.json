  "tests": [
    {
      "name": "running the unimplemented verifier unlocks nothing",
      "script": [
        {
          "set": {
            "verbatim:greet": true
          }
        },
        {
          "user": "(caller gives a name and date of birth)"
        },
        {
          "set": {
            "date_of_birth": "1990-01-01",
            "patient_name": "Sam Example"
          }
        },
        {
          "tool": "verify_patient"
        },
        {
          "user": "(caller waits)"
        },
        {
          "expect": {
            "active": [
              "verify"
            ],
            "blocked": [
              "verify_patient",
              "list_appointments",
              "book_cleaning"
            ]
          }
        },
        {
          "tool": "list_appointments"
        },
        {
          "expect": {
            "blocked": [
              "list_appointments"
            ]
          }
        }
      ]
    }
  ],
  "tools": [
    {
      "description": "Check the caller's full name and date of birth against the patient record. Returns {\"verified\": true} only on an exact match and fails with an error otherwise; after an error the caller may try once more. Call it once you have both details; never read the date of birth back to the caller.",
      "name": "verify_patient",
      "parameters": {
        "properties": {
          "date_of_birth": {
            "description": "Date of birth, YYYY-MM-DD",
            "type": "string"
          },
          "name": {
            "description": "The caller's full name as they gave it",
            "type": "string"
          }
        },
        "required": [
          "name",
          "date_of_birth"
        ],
        "type": "object"
      },
      "response": {
        "verified": false
      },
      "save_response_as": "identity"
    },
    {
      "description": "List the verified caller's upcoming appointments at Bright Smile Dental. Takes no arguments: it uses the patient record matched by verify_patient. Only works after verification.",
      "name": "list_appointments"
    },
    {
      "description": "Find open cleaning appointments near the caller's preferred date and time of day. Returns open times; offer at most three.",
      "name": "check_availability",
      "parameters": {
        "properties": {
          "preferred_date": {
            "description": "Preferred date, YYYY-MM-DD",
            "type": "string"
          },
          "time_of_day": {
            "description": "morning, afternoon or any",
            "enum": [
              "morning",
              "afternoon",
              "any"
            ],
            "type": "string"
          }
        },
        "required": [
          "preferred_date"
        ],
        "type": "object"
      },
      "save_response_as": "availability"
    },
    {
      "description": "Book a cleaning for the verified caller at an open time returned by check_availability. Call only after reading the day, date and time back to the caller and hearing a clear yes.",
      "name": "book_cleaning",
      "parameters": {
        "properties": {
          "slot": {
            "description": "The confirmed appointment start time exactly as returned by check_availability",
            "type": "string"
          }
        },
        "required": [
          "slot"
        ],
        "type": "object"
      },
      "save_response_as": "booking"
    },
    {
      "description": "Transfer the caller to the Bright Smile Dental front desk. Say you are passing them through before calling it.",
      "name": "transfer_to_staff",
      "parameters": {
        "properties": {
          "reason": {
            "enum": [
              "caller_request",
              "urgent_dental_problem",
              "other_request"
            ],
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      }
    }
  ],
  "voice": "Puck"
}
