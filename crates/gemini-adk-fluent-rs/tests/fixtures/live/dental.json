{
  "conversation": {
    "name": "cleaning_booking",
    "overlays": [
      {
        "name": "handoff",
        "resume": "terminate",
        "stages": [
          {
            "allow": [
              "transfer_to_staff"
            ],
            "done": {
              "called_ok": "transfer_to_staff"
            },
            "id": "transfer",
            "say": "Tell the caller you are passing them to the front desk now; if they described an urgent dental problem, say you're putting them straight through. Then call transfer_to_staff."
          }
        ],
        "trigger": {
          "any": [
            {
              "is_true": "intent:human_agent"
            },
            {
              "is_true": "intent:urgent_care"
            }
          ]
        }
      }
    ],
    "policies": [
      {
        "keys": [
          "patient_name",
          "date_of_birth",
          "patient_details"
        ],
        "kind": "redact"
      },
      {
        "idempotency_key": "{slot}",
        "kind": "commit",
        "tool": "book_cleaning"
      }
    ],
    "require": [
      "booked"
    ],
    "stages": [
      {
        "allow": [
          "verify_patient"
        ],
        "id": "greet",
        "next": [
          {
            "to": "verify",
            "when": "always"
          }
        ],
        "say": "Say the disclosure line exactly as written, then ask for the caller's full name and date of birth.",
        "timing": {
          "interruptible": false
        },
        "verbatim": "Thank you for calling Bright Smile Dental. You're speaking with an automated assistant, and this call may be recorded."
      },
      {
        "allow": [
          "verify_patient"
        ],
        "collect": [
          "patient_name",
          "date_of_birth"
        ],
        "commit": {
          "tool": "verify_patient",
          "when": {
            "not": {
              "done": "handoff_unverified"
            }
          }
        },
        "done": {
          "eq": [
            "identity",
            {
              "verified": true
            }
          ]
        },
        "id": "verify",
        "next": [
          {
            "to": "appointments",
            "when": {
              "eq": [
                "identity",
                {
                  "verified": true
                }
              ]
            }
          }
        ],
        "repair": {
          "escalate_after": 6,
          "escalate_after_tool_failures": 2,
          "escalate_to": "handoff_unverified",
          "reprompt_after": 2
        },
        "say": "Get the caller's full name and date of birth and check them with verify_patient. Never repeat the date of birth aloud. If the check does not match, say you couldn't find a match for those details without saying which part was wrong, and let them try once more."
      },
      {
        "allow": [
          "list_appointments"
        ],
        "commit": {
          "tool": "list_appointments",
          "when": {
            "eq": [
              "identity",
              {
                "verified": true
              }
            ]
          }
        },
        "id": "appointments",
        "next": [
          {
            "to": "find_time",
            "when": {
              "called_ok": "list_appointments"
            }
          }
        ],
        "repair": {
          "escalate_after": 4,
          "escalate_after_tool_failures": 2,
          "escalate_to": "handoff_lookup",
          "reprompt_after": 2
        },
        "say": "Thank the caller for confirming. Call list_appointments and tell them about any upcoming appointments, with dates and times only. If a cleaning is already booked, mention it and ask whether they still want another one.",
        "timing": {
          "filler_after_ms": 1200
        }
      },
      {
        "allow": [
          "check_availability"
        ],
        "collect": [
          "slot"
        ],
        "done": {
          "all": [
            {
              "called_ok": "check_availability"
            },
            {
              "captured": [
                "slot"
              ]
            }
          ]
        },
        "id": "find_time",
        "next": [
          {
            "to": "confirm",
            "when": {
              "all": [
                {
                  "called_ok": "check_availability"
                },
                {
                  "captured": [
                    "slot"
                  ]
                }
              ]
            }
          }
        ],
        "repair": {
          "escalate_after": 6,
          "escalate_after_tool_failures": 2,
          "escalate_to": "handoff_find_time",
          "reprompt_after": 2
        },
        "say": "Ask which day and time of day suit the caller for a cleaning, call check_availability, and offer up to three of the open times. Let the caller choose one.",
        "timing": {
          "filler_after_ms": 1200
        }
      },
      {
        "allow": [
          "book_cleaning",
          "check_availability"
        ],
        "commit": {
          "tool": "book_cleaning",
          "when": {
            "all": [
              {
                "called_ok": "list_appointments"
              },
              {
                "called_ok": "check_availability"
              },
              {
                "is_true": "book_cleaning_confirmed"
              },
              {
                "not": {
                  "any": [
                    {
                      "done": "handoff_unverified"
                    },
                    {
                      "done": "handoff_lookup"
                    },
                    {
                      "done": "handoff_find_time"
                    },
                    {
                      "done": "handoff_confirm"
                    }
                  ]
                }
              }
            ]
          }
        },
        "ground": "The caller chose a cleaning at {slot}.",
        "id": "confirm",
        "next": [
          {
            "to": "booked",
            "when": {
              "called_ok": "book_cleaning"
            }
          }
        ],
        "repair": {
          "escalate_after": 4,
          "escalate_after_tool_failures": 2,
          "escalate_to": "handoff_confirm",
          "reprompt_after": 2
        },
        "say": "Read back the appointment: a cleaning at Bright Smile Dental, with the day of the week, the date and the time. Ask the caller to confirm, and call book_cleaning only after a clear yes. If they want a different time, check availability again and read the new time back.",
        "timing": {
          "filler_after_ms": 1200
        }
      },
      {
        "id": "booked",
        "say": "Tell the caller the cleaning is booked, repeat the day, date and time once, give the booking reference if there is one, and say goodbye.",
        "terminal": true
      },
      {
        "id": "handoff_unverified",
        "say": "Apologise that you couldn't confirm their details, and say you're passing them to the front desk team, who can help. Do not say which detail didn't match, and do not discuss any appointments.",
        "terminal": true
      },
      {
        "id": "handoff_lookup",
        "say": "Apologise that you can't look up their appointments right now, and say you're passing them to the front desk team.",
        "terminal": true
      },
      {
        "id": "handoff_find_time",
        "say": "Apologise that you couldn't find a time together, and say you're passing them to the front desk team, who can help.",
        "terminal": true
      },
      {
        "id": "handoff_confirm",
        "say": "Say the cleaning has not been booked, apologise, and say you're passing them to the front desk team to finish booking.",
        "terminal": true
      }
    ]
  },
  "description": "Phone line for Bright Smile Dental that verifies existing patients and books cleanings.",
  "extract": [
    {
      "instruction": "Extract the caller's full name and date of birth exactly as the caller gave them. Write the date of birth as YYYY-MM-DD. Leave a field out if the caller has not said it.",
      "name": "patient_details",
      "promote": [
        {
          "field": "patient_name",
          "policy": "keep_known"
        },
        {
          "field": "date_of_birth",
          "policy": "keep_known"
        }
      ],
      "schema": {
        "properties": {
          "date_of_birth": {
            "type": "string"
          },
          "patient_name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "instruction": "Extract the cleaning appointment time the caller chose from the open times the assistant offered, as the day of the week, date and time (for example 'Tuesday 14 October, 9:00 AM'). Only fill it once the caller has picked one of the offered times. If the caller changes their choice, give the new one.",
      "name": "booking_choice",
      "promote": [
        {
          "field": "slot",
          "policy": "overwrite"
        }
      ],
      "schema": {
        "properties": {
          "slot": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "instruction": "Read the latest turns of the conversation. Set a field to true only when the caller clearly said so in their own words. Otherwise leave it out.",
      "name": "caller_signals",
      "promote": [
        {
          "field": "book_cleaning_confirmed",
          "policy": "true_only"
        },
        {
          "field": "intent_human_agent",
          "policy": "true_only",
          "to": "intent:human_agent"
        },
        {
          "field": "intent_urgent_care",
          "policy": "true_only",
          "to": "intent:urgent_care"
        }
      ],
      "schema": {
        "properties": {
          "book_cleaning_confirmed": {
            "description": "The caller said yes to booking the cleaning after the assistant read back the day, date and time.",
            "type": "boolean"
          },
          "intent_human_agent": {
            "description": "The caller asked to speak to a person, the receptionist or the front desk, or said yes when the assistant offered to pass them to the front desk.",
            "type": "boolean"
          },
          "intent_urgent_care": {
            "description": "The caller described an urgent dental problem: severe pain, swelling, heavy bleeding, or a broken or knocked-out tooth.",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  ],
  "greeting": "Say the disclosure line word for word, then say you can help book a cleaning and ask for the caller's full name and date of birth.",
  "instruction": "You are the phone assistant for Bright Smile Dental. You help existing patients book a routine dental cleaning. Keep every reply to one or two short spoken sentences. Never invent appointment times, prices, opening hours, insurance details or policies: use the tools, and if you don't know something, offer to pass the caller to the front desk. Never say the caller's date of birth aloud, and never read out or confirm any appointment until the caller has been verified. If the caller wants anything other than booking a cleaning, such as registering as a new patient, rescheduling, cancelling, billing or insurance, say the front desk can help and offer to pass them through. Do not give dental or medical advice. If the caller mentions trouble breathing or swallowing, or swelling spreading to the eye or neck, tell them to hang up and call emergency services now.",
  "modality": "audio",
  "models": {
    "extraction": "gemini-3.1-flash-lite"
  },
  "name": "bright-smile-cleanings",
  "runtime": {
    "steering": "context_update"
  },
