          "save_response_as": "result"
        }
      ]
    },
    {
      "name": "ticket_status",
      "version": "2.0.0",
      "description": "Verify an account and look up an existing engineer ticket; do not create or modify tickets.",
      "instruction": "Verify an account and look up an existing engineer ticket; do not create or modify tickets. These are controlled demo data, not live account records or persistent actions. Ask for the declared business inputs. Do not reuse another task’s verification. Use the tool receipt for the answer and complete with the declared result. A commit creates an exact proposal: explain its arguments, wait for application approval, then report only its successful receipt. Spoken consent does not approve an operation.",
      "inputs": {
        "account_number": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "ticket_reference": {
          "type": "string"
        }
      },
      "outputs": {
        "result": {
          "type": "object"
        }
      },
      "tools": [
        {
          "name": "verify_ticket_account",
          "description": "Check ownership of the ticket against account and postcode in the demo record. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              },
              "ticket_reference": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "postcode",
              "ticket_reference"
            ],
            "additionalProperties": false
          },
          "response": {
            "verified": true
          },
          "set_state": {
            "verified": true
          }
        },
        {
          "name": "lookup_ticket_status",
          "description": "Retrieve the verified ticket progress fixture. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "ticket_reference": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "ticket_reference"
            ],
            "additionalProperties": false
          },
          "response": {
            "ticket": "NW-88412",
            "status": "engineer_assigned",
            "appointment": "Thursday 09:00–12:00 demo slot"
          },
          "save_response_as": "result"
        }
      ],
      "flow": {
        "steps": [
          {
            "id": "verify",
            "posture": "Use the admitted tools and report their controlled demo result.",
            "allow": [
              "verify_ticket_account"
            ],
            "done": {
              "is_true": "verified"
            }
          },
          {
            "id": "lookup",
            "posture": "Use the admitted tools and report their controlled demo result.",
            "allow": [
              "lookup_ticket_status"
            ],
            "done": {
              "called_ok": "lookup_ticket_status"
            },
            "after": [
              "verify"
            ]
          },
          {
            "id": "done",
            "after": [
              "lookup"
            ],
            "terminal": true
          }
        ],
        "constraints": [
          {
            "never_until": {
              "tool": "lookup_ticket_status",
              "until": {
                "is_true": "verified"
              }
            }
          },
          {
            "require": [
              "done"
            ]
          }
        ]
      },
      "state": {
        "verified": {
          "type": "boolean",
          "default": false
        }
      }
    },
