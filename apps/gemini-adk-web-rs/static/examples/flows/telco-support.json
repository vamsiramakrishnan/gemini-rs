{
  "name": "telco-support",
  "version": "2.0.0",
  "description": "Northwire voice support: governed diagnostics and repair, independent outage lookup, verified ticket status and plan information. Controlled demo fixtures.",
  "instruction": "You are one voice assistant. Route to the relevant independently usable capability; start its task with real business inputs. Do not activate an unrelated workflow just to answer a public question. A public information capability may be a child task; complete it and resume its parent without repeating finished work. Private tasks verify their own account/order. All service responses are controlled demo fixtures; no real account lookup, payment, transfer or persistent change occurs. Commits require exact proposals and explicit approval in the application, never spoken consent. Wait for a successful receipt before claiming a demo action finished.",
  "greeting": "Introduce Northwire support and ask whether the caller needs connection troubleshooting, outage information, ticket progress or plan information.",
  "modality": "audio",
  "voice": "Kore",
  "skills": [
    {
      "name": "technical_support",
      "version": "2.0.0",
      "description": "You are the technical support assistant for Northwire Broadband. Authenticate the account first, then diagnose before promising anything. Raise a ticket when the line test fails.",
      "instruction": "You are the technical support assistant for Northwire Broadband. Authenticate the account first, then diagnose before promising anything. Raise a ticket when the line test fails. These are controlled demo data, not live account records or persistent actions. Ask for the declared business inputs. Do not reuse another task’s verification. Use the tool receipt for the answer and complete with the declared result. A commit creates an exact proposal: explain its arguments, wait for application approval, then report only its successful receipt. Spoken consent does not approve an operation.",
      "inputs": {
        "account_number": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        }
      },
      "outputs": {
        "result": {
          "type": "object"
        }
      },
      "tools": [
        {
          "name": "authenticate_account",
          "description": "Verify the account number and postcode in the successful demo record. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "postcode"
            ],
            "additionalProperties": false
          },
          "response": {
            "authenticated": true,
            "plan": "Fibre 500"
          },
          "set_state": {
            "authenticated": true
          }
        },
        {
          "name": "run_line_test",
          "description": "Run the demo diagnostic for the specified account and line. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "line_id": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "line_id"
            ],
            "additionalProperties": false
          },
          "response": {
            "status": "degraded",
            "sync_speed_mbps": 61,
            "expected_mbps": 500
          },
          "set_state": {
            "line_tested": true,
            "line_ok": false,
            "retest_requested": false
          }
        },
        {
          "name": "send_reset_signal",
          "description": "Propose a reset of the specified account router line. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "commit",
            "idempotency_argument": "request_id"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "line_id": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "line_id",
              "request_id"
            ],
            "additionalProperties": false
          },
          "response": {
            "sent": true,
            "line_id": "LINE-44"
          },
          "set_state": {
            "reset_sent": true
          }
        },
        {
          "name": "create_ticket",
          "description": "Propose an engineer ticket containing this line and diagnostic summary. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "commit",
            "idempotency_argument": "request_id"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "line_id": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "line_id",
              "summary",
              "request_id"
            ],
            "additionalProperties": false
          },
          "response": {
            "ticket": "NW-88412",
            "sla_hours": 48
          },
          "set_state": {
            "ticket_raised": true
          },
          "save_response_as": "result"
        },
        {
          "name": "request_retest",
          "description": "Record a task-local request to reopen the diagnostic after a power cycle. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "response": {
            "queued": true
          },
          "set_state": {
            "retest_requested": true
          }
        },
        {
          "name": "reject_account",
          "description": "Read the separate failed-verification fixture; this does not authenticate the account. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "account_number": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "postcode"
            ],
            "additionalProperties": false
          },
          "response": {
            "authenticated": false,
            "reason": "Account details do not match"
          },
          "set_state": {
            "authentication_failed": true
          }
        }
      ],
      "flow": {
        "steps": [
          {
            "id": "authenticate",
            "posture": "Authenticate the account before discussing line details.",
            "allow": [
              "authenticate_account",
              "reject_account"
            ],
            "done": {
              "is_true": "authenticated"
            }
          },
          {
            "id": "diagnose",
            "after": [
              "authenticate"
            ],
            "posture": "Run the line test and read the result back honestly — never promise a fix before the diagnostic.",
            "allow": [
              "run_line_test"
            ],
            "done": {
              "called_ok": "run_line_test"
            },
            "ground": "Line test {line_tested?complete:not yet run}."
          },
          {
            "id": "resolve",
            "after": [
              "diagnose"
            ],
            "posture": "Try a remote reset first. If the line is still degraded, raise an engineer ticket and give the reference and SLA.",
            "allow": [
              "send_reset_signal",
              "create_ticket"
            ],
            "done": {
              "any": [
                {
                  "is_true": "line_ok"
                },
                {
                  "is_true": "ticket_raised"
                }
              ]
            }
          },
          {
            "id": "wrap_up",
            "after": [
              "resolve"
            ],
            "terminal": true
          }
        ],
        "constraints": [
          {
            "once": "create_ticket"
          },
          {
            "never_until": {
              "tool": "create_ticket",
              "until": {
                "is_true": "line_tested"
              }
            }
          },
          {
            "require": [
              "wrap_up"
            ]
          },
          {
            "reset": {
              "steps": [
                "diagnose"
              ],
              "when": {
                "is_true": "retest_requested"
              }
            }
          },
          {
            "never_until": {
              "tool": "run_line_test",
              "until": {
                "is_true": "authenticated"
              }
            }
          },
          {
            "never_until": {
              "tool": "send_reset_signal",
              "until": {
                "is_true": "line_tested"
              }
            }
          }
        ],
        "ambient": [
          "request_retest"
        ]
      },
      "state": {
        "authenticated": {
          "type": "boolean",
          "default": false
        },
        "line_tested": {
          "type": "boolean",
          "default": false
        },
        "line_ok": {
          "type": "boolean",
          "default": false
        },
        "retest_requested": {
          "type": "boolean",
          "default": false
        },
        "reset_sent": {
          "type": "boolean",
          "default": false
        },
        "ticket_raised": {
          "type": "boolean",
          "default": false
        },
        "authentication_failed": {
          "type": "boolean",
          "default": false
        }
      },
      "tests": [
        {
          "name": "degraded line ends in a ticket",
          "script": [
            {
              "expect": {
                "active": [
                  "authenticate"
                ],
                "blocked": [
                  "create_ticket"
                ]
              }
            },
            {
              "tool": "authenticate_account"
            },
            {
              "tool": "run_line_test"
            },
            {
              "expect": {
                "done": [
                  "authenticate",
                  "diagnose"
                ],
                "active": [
                  "resolve"
                ]
              }
            },
            {
              "tool": "send_reset_signal"
            },
            {
              "tool": "create_ticket"
            },
            {
              "expect": {
                "done": [
                  "resolve",
                  "wrap_up"
                ],
                "complete": true
              }
            }
          ]
        },
        {
          "name": "no ticket without a diagnostic",
          "script": [
            {
              "tool": "authenticate_account"
            },
            {
              "tool": "create_ticket"
            },
            {
              "expect": {
                "blocked": [
                  "create_ticket"
                ],
                "complete": false
              }
            }
          ]
        },
        {
          "name": "ticket is single-use",
          "script": [
            {
              "tool": "authenticate_account"
            },
            {
              "tool": "run_line_test"
            },
            {
              "tool": "create_ticket"
            },
            {
              "tool": "create_ticket"
            },
            {
              "expect": {
                "blocked": [
                  "create_ticket"
                ],
                "done": [
                  "resolve"
                ]
              }
            }
          ]
        },
        {
          "name": "retest reopens the diagnostic",
          "script": [
            {
              "tool": "authenticate_account"
            },
            {
              "tool": "run_line_test"
            },
            {
              "expect": {
                "done": [
                  "diagnose"
                ]
              }
            },
            {
              "tool": "request_retest"
            },
            {
              "expect": {
                "active": [
                  "diagnose"
                ]
              }
            },
            {
              "tool": "run_line_test"
            },
            {
              "expect": {
                "done": [
                  "diagnose"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "outage_lookup",
      "version": "2.0.0",
      "description": "Look up public network outages by postcode without requesting account authentication.",
      "instruction": "Look up public network outages by postcode without requesting account authentication. These are controlled demo data, not live account records or persistent actions. Ask for the declared business inputs. Do not reuse another task’s verification. Use the tool receipt for the answer and complete with the declared result. A commit creates an exact proposal: explain its arguments, wait for application approval, then report only its successful receipt. Spoken consent does not approve an operation.",
      "inputs": {
        "postcode": {
          "type": "string"
        }
      },
      "outputs": {
        "result": {
          "type": "object"
        }
      },
      "tools": [
        {
          "name": "lookup_outage",
          "description": "Read the public outage fixture for the stated postcode. Controlled demo fixture; no external service is contacted.",
          "effect": {
            "kind": "read"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "postcode": {
                "type": "string"
              }
            },
            "required": [
